
# Required
SECRET_KEY=change-me-to-a-long-random-string

# Database — choose one:
#
# A) Remote provider (Supabase, RDS, etc.)
DATABASE_URL=postgresql://user:password@host:5432/database
#
# B) Local Docker Postgres (no external provider)
#    Start DB:  docker compose --profile local-db up -d db
#    Use the host URL in .env (migrations, local tools, and Docker):
#    DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/sandbox
#    Inside a container, 127.0.0.1:5433 is rewritten to db:5432 automatically.

# Optional
CORS_ORIGINS=http://localhost:8080
ACCESS_TOKEN_EXPIRE_MINUTES=10
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_SIGNING_ALGORITHM=HS256
ACCESS_TOKEN_COOKIE_NAME=access_token
REFRESH_TOKEN_COOKIE_NAME=refresh_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
POOL_PRE_PING=false
DB_ECHO=true
LOG_LEVEL=INFO
LOG_JSON=true

# Scheduler (starts with default docker compose up; set false to no-op in the scheduler container)
SCHEDULER_ENABLED=true
CRON_POPULAR_ASSETS=0 */4 * * *
CRON_FEAR_AND_GREED=0 0,12 * * *
TIMEZONE=Europe/Tallinn

# Redis (refresh cooldown). Start it:  docker compose up -d redis
# Docker Compose sets redis://redis:6379/0 for the app container; this value is for running uvicorn on the host.
REDIS_URL=redis://localhost:6379/0

# Migrations run separately (CI/CD or locally):
#   python scripts/migrate.py

# R2 WORKER
R2_WORKER_URL=xxxxxxxxxxxxxx
R2_UPLOAD_KEY=your-worker-upload-key
