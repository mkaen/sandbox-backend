# Live production — copy to .env.prod
#   cp .env.prod.example .env.prod
# Use a separate database from local development.

SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql://user:password@host:5432/database

# Live frontend origin(s), comma-separated
CORS_ORIGINS=https://example.com

ACCESS_TOKEN_EXPIRE_MINUTES=10
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_SIGNING_ALGORITHM=HS256
ACCESS_TOKEN_COOKIE_NAME=access_token
REFRESH_TOKEN_COOKIE_NAME=refresh_token

# Compose overrides COOKIE_SECURE=true and POOL_PRE_PING=true.
# If the frontend is on a different site (not a subdomain of the API), set:
# COOKIE_SAMESITE=none
COOKIE_SAMESITE=lax

LOG_LEVEL=INFO
