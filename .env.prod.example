# Live production — copy to .env.prod
#   cp .env.prod.example .env.prod
# Use a separate database from local development.

SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql://user:password@host:5432/database

# Live frontend origin(s), comma-separated
CORS_ORIGINS=https://example.com

ACCESS_TOKEN_EXPIRE_MINUTES=10
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_SIGNING_ALGORITHM=HS256
ACCESS_TOKEN_COOKIE_NAME=access_token
REFRESH_TOKEN_COOKIE_NAME=refresh_token

# Compose overrides COOKIE_SECURE=true and POOL_PRE_PING=true.
# If the frontend is on a different site (not a subdomain of the API), set:
# COOKIE_SAMESITE=none
COOKIE_SAMESITE=lax

LOG_LEVEL=INFO

SCHEDULER_ENABLED=true
CRON_POPULAR_ASSETS=0 */4 * * *
CRON_FEAR_AND_GREED=0 0,12 * * *
TIMEZONE=Europe/Tallinn

# Compose sets REDIS_URL=redis://redis:6379/0 for the bundled Redis service.
# Override here only if you use an external Redis:
# REDIS_URL=redis://host:6379/0

# R2 WORKER
R2_WORKER_URL=xxx
R2_UPLOAD_KEY=your-worker-upload-key
